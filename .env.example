# Copia este archivo a .env para desarrollo local.

# Usuario root de MongoDB. Solo se aplica cuando el volumen está vacío:
# para cambiarlo después hay que ejecutar make db-reset.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me

# Conexión de la API. La contraseña va URL-encoded.
MONGO_URI="mongodb://root:change-me@127.0.0.1:27017/?authSource=admin"
MONGO_DB_NAME=personal_blog

# Secreto para firmar los JWT: obligatorio, de al menos 32 bytes. Genera uno con
# openssl rand -base64 32 y pégalo entre comillas simples. Nunca lo subas a git.
JWT_SECRET=

# Orígenes con permiso de CORS, separados por comas: esquema://host[:puerto],
# exactos y sin comodines. Vacía, ningún navegador puede cambiar estado.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Tamaño máximo del cuerpo de una petición, en bytes.
MAX_BODY_BYTES=1048576

# Proxies de confianza: IPs o rangos CIDR del par directo, separados por comas.
# Vacía en local: la IP del cliente es la del socket.
TRUSTED_PROXIES=

# Rate limit por IP y por usuario autenticado (peticiones por minuto y ráfaga).
# Vacías, usan los valores por defecto de ADR-010 y ADR-016.
RATE_LIMIT_GLOBAL_PER_MINUTE=60
RATE_LIMIT_GLOBAL_BURST=20
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_BURST=5
RATE_LIMIT_REFRESH_PER_MINUTE=10
RATE_LIMIT_REFRESH_BURST=10
RATE_LIMIT_PREFLIGHT_PER_MINUTE=120
RATE_LIMIT_PREFLIGHT_BURST=60
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_USER_BURST=100

# Administrador inicial. Solo se usa si la colección users está vacía; con
# usuarios existentes se ignora. Vacías, la API arranca sin administrador.
# Contraseña: de 12 caracteres a 72 bytes. Si lleva $, # o espacios, va entre
# comillas simples.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Formato de los logs: text (por defecto, para la terminal) o json (para Cloud
# Logging en producción).
LOG_FORMAT=text

# Modo de Gin: debug, release o test. Vacía: debug con LOG_FORMAT=text y release
# con json. En producción, release.
GIN_MODE=
